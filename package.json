{
  "name": "wechatgame-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "微信小游戏矩阵：共用游戏框架 + 每款游戏独立目录（策划 / 程序 / 美术 / 构建）",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prepare": "node tools/scripts/install-githooks.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "check:arch": "node tools/scripts/check-architecture.mjs",
    "check:es5spread": "node tools/scripts/check-es5-spread.mjs",
    "check:es5spread:selftest": "bash tools/scripts/check-es5-spread-selftest.sh",
    "check:secrets": "node tools/scripts/check-secrets.mjs",
    "check:links": "node tools/scripts/check-ide-links.mjs",
    "check:plugins": "node tools/scripts/check-plugin-anchor.mjs",
    "mcp:build": "node tools/scripts/build-mcp-configs.mjs",
    "check:mcp": "node tools/scripts/build-mcp-configs.mjs --check",
    "levels:sync": "node tools/scripts/sync-levels-data.mjs",
    "levels:check": "node tools/scripts/sync-levels-data.mjs --check",
    "palettes:sync": "node tools/scripts/sync-palettes.mjs",
    "palettes:check": "node tools/scripts/sync-palettes.mjs --check",
    "framework:sync": "node tools/scripts/sync-framework-to-cocos.mjs",
    "framework:sync:check": "node tools/scripts/sync-framework-to-cocos.mjs --check",
    "cocos:check": "node tools/scripts/check-cocos-scripts.mjs",
    "build:cocos": "pnpm -r run build:cocos",
    "build:cocos:web": "pnpm -r run build:cocos:web",
    "check:size": "node tools/scripts/check-bundle-size.mjs",
    "check:size:selftest": "node tools/scripts/check-bundle-size.mjs --selftest",
    "ctx:build": "node tools/scripts/build-context-index.mjs",
    "ctx:check": "node tools/scripts/check-context-budget.mjs",
    "ctx:selftest": "bash tools/scripts/worktree-authoritative-selftest.sh",
    "ctx:reads": "node tools/scripts/collect-context-reads.mjs",
    "ctx:usage": "node tools/scripts/analyze-context-usage.mjs",
    "ctx:usage:selftest": "bash tools/scripts/context-usage-selftest.sh",
    "ctx:rotate": "node tools/scripts/rotate-reads-ledger.mjs",
    "tasks:archive": "node tools/scripts/archive-tasks.mjs",
    "tasks:archive:selftest": "bash tools/scripts/archive-tasks-selftest.sh",
    "memory:distill": "node tools/scripts/distill-memory.mjs",
    "memory:split": "node tools/scripts/split-memory-detail.mjs",
    "memory:split:selftest": "bash tools/scripts/split-memory-detail-selftest.sh",
    "memory:distill:selftest": "bash tools/scripts/distill-memory-selftest.sh",
    "kb:sync": "node tools/scripts/kb-sync.mjs",
    "kb:collect": "node tools/scripts/kb-collect.mjs",
    "kb:touch": "node tools/scripts/kb-touch.mjs",
    "kb:audit": "node tools/scripts/kb-audit.mjs",
    "kb:archive": "node tools/scripts/kb-archive.mjs",
    "kb:reactivate": "node tools/scripts/kb-reactivate.mjs",
    "kb:check": "node tools/scripts/kb-check.mjs",
    "kb:selftest": "bash tools/scripts/knowledge-selftest.sh",
    "knowledge:split": "node tools/scripts/split-knowledge-lessons.mjs",
    "knowledge:split:selftest": "bash tools/scripts/split-knowledge-lessons-selftest.sh",
    "harness": "node tools/scripts/serve-harness.mjs",
    "harness:build": "node tools/scripts/serve-harness.mjs --build-only",
    "harness:smoke": "node tools/scripts/smoke-harness.mjs",
    "preview:frames": "node tools/scripts/render-harness-frame.mjs --game=breakout",
    "preview:frames:beads": "node tools/scripts/render-harness-frame.mjs --game=beads",
    "preview:clip": "node tools/scripts/render-harness-clip.mjs --game=breakout",
    "preview:clip:beads": "node tools/scripts/render-harness-clip.mjs --game=beads",
    "commitlint": "commitlint",
    "verify": "node tools/scripts/verify-all.mjs",
    "check:a11y": "node tools/scripts/check-a11y-anchors.mjs",
    "verify:strict": "node tools/scripts/verify-all.mjs --strict",
    "verify:selftest": "bash tools/scripts/verify-all-selftest.sh",
    "selftest:fast": "node tools/scripts/selftests.mjs --tier=fast",
    "selftest:heavy": "node tools/scripts/selftests.mjs --tier=heavy",
    "ci:review:selftest": "bash tools/scripts/ci-pr-review-selftest.sh",
    "check:tasks": "node tools/scripts/check-tasks.mjs",
    "check:host-tests": "node tools/scripts/check-host-behavior-tests.mjs",
    "check:host-tests:selftest": "node tools/scripts/check-host-behavior-tests.mjs --selftest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "jsfxr": "^1.4.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}