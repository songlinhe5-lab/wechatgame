{
  "name": "wechatgame-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "微信小游戏矩阵：共用游戏框架 + 每款游戏独立目录（策划 / 程序 / 美术 / 构建）",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prepare": "node tools/scripts/install-githooks.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "check:arch": "node tools/scripts/check-architecture.mjs",
    "check:links": "node tools/scripts/check-ide-links.mjs",
    "check:plugins": "node tools/scripts/check-plugin-anchor.mjs",
    "mcp:build": "node tools/scripts/build-mcp-configs.mjs",
    "check:mcp": "node tools/scripts/build-mcp-configs.mjs --check",
    "levels:sync": "node tools/scripts/sync-levels-data.mjs",
    "levels:check": "node tools/scripts/sync-levels-data.mjs --check",
    "ctx:build": "node tools/scripts/build-context-index.mjs",
    "ctx:check": "node tools/scripts/check-context-budget.mjs",
    "ctx:reads": "node tools/scripts/collect-context-reads.mjs",
    "ctx:usage": "node tools/scripts/analyze-context-usage.mjs",
    "ctx:rotate": "node tools/scripts/rotate-reads-ledger.mjs",
    "tasks:archive": "node tools/scripts/archive-tasks.mjs",
    "kb:sync": "node tools/scripts/kb-sync.mjs",
    "kb:collect": "node tools/scripts/kb-collect.mjs",
    "kb:touch": "node tools/scripts/kb-touch.mjs",
    "kb:audit": "node tools/scripts/kb-audit.mjs",
    "kb:archive": "node tools/scripts/kb-archive.mjs",
    "kb:reactivate": "node tools/scripts/kb-reactivate.mjs",
    "kb:check": "node tools/scripts/kb-check.mjs",
    "harness": "node tools/scripts/serve-harness.mjs",
    "harness:build": "node tools/scripts/serve-harness.mjs --build-only",
    "harness:smoke": "node tools/scripts/smoke-harness.mjs",
    "preview:frames": "node tools/scripts/render-harness-frame.mjs",
    "preview:clip": "node tools/scripts/render-harness-clip.mjs",
    "commitlint": "commitlint",
    "verify": "pnpm run check:arch && pnpm run check:links && pnpm run check:mcp && pnpm run levels:check && pnpm run typecheck && pnpm run test && pnpm run harness:build && pnpm run harness:smoke"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
