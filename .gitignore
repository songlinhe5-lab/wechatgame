# 依赖
node_modules/
.pnpm-store/

# 构建产物
build/
dist/
out/
*.tsbuildinfo

# 浏览器验证器的临时副本
dev/harness/.smoke/

# Headless PR 审查的临时 diff / agent 输出（WXG-T-025；运行 ci-pr-review.sh 时产生）
.review/

# 测试与覆盖率
coverage/

# IDE 会话工具产物（Agent 运行时计划文件，非项目资产）
.codebuddy/plans/

# Cursor 读埋点探针日志（WXG-T-036，log-only 诊断产物，非项目资产）
.cursor/hooks/.read-probe.jsonl
.cursor/hooks/.read-probe.jsonl.1

# Cocos Creator 本地生成物（assets/ 与 settings/ 必须提交，含 .meta）
games/*/cocos/library/
games/*/cocos/temp/
games/*/cocos/local/
games/*/cocos/profiles/
games/*/cocos/native/
games/*/cocos/build/
games/*/cocos/.creator/
# 预览页模板：编辑器在打开「项目设置 → 预览」时自动生成，内容为编辑器默认模板，
# 本仓不自定义预览页 ⇒ 忽略（2026-09-14 裁定）。若将来要自定义（如强制竖屏 viewport），
# 把它改回纳入版本控制并删掉本行。
games/*/cocos/preview-template/

# 微信小游戏产物
games/*/build/wechatgame/
mini-game-build/

# 系统
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量
.env
.env.local

# 密钥与凭证（红线：严禁入仓）——真源 control-manifest §10 / ADR-0010 §4.2-5；
# 机械守卫 tools/scripts/check-secrets.mjs（pre-commit / CI / verify 三处都跑）
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Cocos Creator 工程本地缓存（编辑器生成，永不入库）
games/*/cocos/library/
games/*/cocos/temp/
games/*/cocos/profiles/
games/*/cocos/local/
games/*/cocos/build/
games/*/cocos/extensions/
.DS_Store

# Cocos Creator 工程本地缓存（编辑器生成，永不入库）
games/*/cocos/library/
games/*/cocos/temp/
games/*/cocos/profiles/
games/*/cocos/local/
games/*/cocos/build/
games/*/cocos/extensions/
.DS_Store
games/*/cocos/native/
.playwright-cli/
# 会话临时诊断物（脚本/日志/取样），留盘不入库
temp/

# QA 取证物：留盘不入库（体例：production/qa/beads/evidence 只入库 .mjs 脚本，
# *.log 已由上方全局规则忽略；json/png/jpg 为逐帧像素/包络/截图取样物（burst v2.1
# 捕获通道改 CDP screencast 后产物为 jpeg），复核请读盘）
production/qa/*/evidence/**/*.json
production/qa/*/evidence/**/*.png
production/qa/*/evidence/**/*.jpg

# Cocos 工程配置含本地微信 AppID（WXG-T-099/B4：红线 control-manifest §10，不入仓；模板见 games/beads/cocos/project.config.example.json）
games/*/project.config.json
games/*/project.private.config.json
# ⚠️ 上一行层级不够：Cocos 工程配置实际在 games/<g>/cocos/ 下（WXG-T-129 指引实测漏网）
games/*/cocos/project.config.json
games/*/cocos/project.private.config.json
# 仓库根同款：微信 DevTools 打开 monorepo 根时本地生成（含真实 AppID，b6d6c65 忽略层级订正后暴露；WXG-T-161 门禁登记待处置 ⇒ 本行即处置）
/project.config.json
/project.private.config.json

# vendor skill 克隆是内嵌 git 仓库：git 只能记空 gitlink（内容会静默丢失）⇒ 不纳管，保留在盘上
my-skills/_repos/mattpocock-skills/
my-skills/_repos/superpowers/
games/beads/vitest.config.ts.timestamp-*.mjs

# 隔离 git worktree（临时验证用，防整棵树被误提交）
.worktrees/

# beads-studio（WXG-T-179 Web 服务）：用户生成结果与像素底稿是运行时数据，不入库
apps/beads-studio/data/
