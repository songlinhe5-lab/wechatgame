// ADR-0028 tint mask shader：out = base * d + (1 - base) * l

CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        baseColor: { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
        maskTexture: { value: white }
}%

CCProgram vs %{
  precision highp float;
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 v_color;
  out vec2 v_uv;
  uniform Constant {
    vec4 baseColor;
  };
  void main () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    v_color = a_color * baseColor;
    v_uv = a_texCoord;
    gl_Position = pos;
  }
}%

CCProgram fs %{
  precision highp float;
  in vec4 v_color;
  in vec2 v_uv;
  out vec4 fragColor;
  uniform Constant {
    vec4 baseColor;
  };
  uniform sampler2D maskTexture;
  void main () {
    vec4 mask = texture(maskTexture, v_uv);
    vec3 d = mask.rgb;  // 暗系数（multiply 路）
    float l = mask.a;   // 亮系数（screen 路）
    vec3 base = baseColor.rgb;
    // ADR-0028 §2.1：out = base * d + (1 - base) * l
    vec3 outColor = base * d + (1.0 - base) * l;
    fragColor = vec4(outColor, v_color.a * mask.a);
  }
}%
