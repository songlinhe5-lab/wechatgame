#!/usr/bin/env sh
# 跨 IDE 统一：任意 git commit 前跑门禁。
# 步骤：⓪ pnpm run check:secrets（密钥入仓守卫，WXG-T-047；红线，**拦截不修复**）
#       ① pnpm run check:links（四 IDE 指针完整性）
#       ② 暂存区含 .md 时 → **自动重建上下文索引并重新暂存**（WXG-T-032 ⑤，2026-09-13）：
#          `ctx/index.json` 描述「已提交内容（HEAD）」，而任何「改被索引 .md 的提交」其暂存内容
#          必然 ≠ HEAD 锚定的旧索引 → 旧的拦截式 `ctx:check --staged` **结构性不可通过**
#          （实测只能靠 --no-verify 绕过）。故 ② 不再拦截，改为：
#            a. `ctx:build --staged-blobs`（暂存 .md 按**暂存 blob** 内容索引，暂存新文件一并纳入）；
#            b. `git add ctx/index.json ctx/BUDGET.md ctx/hot-files.md memory/INDEX.md`
#               （重新暂存产物，随本次提交入库；`memory/INDEX.md` 是 WXG-T-068 新增的 memory
#               摘要层产物 —— 与 BUDGET/hot-files 同为 ctx:build 生成物，故**必须**一并暂存）；
#               ⚠️ 三个产物必须一起暂存：`ctx/hot-files.md` 是 `ctx:build` 生成的**新文件**（WXG-T-036 q-1），
#                  首次提交若漏 add 则永不入库 → CI 干净检出缺该文件，`ctx/ROUTES.md §0` 第二跳（锚点→
#                  offset/limit）直接断链，且 A 项预算表缺行。新增 ctx 产物时**必须同步登记到本行**。
#            c. `ctx:check --staged` 仅作**兜底终校验**（正常路径恒绿，仅竞态/意外时拦截）。
# 启用：git config core.hooksPath .githooks（见 tools/scripts/install-githooks.mjs）

set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

# ⓪ 密钥入仓守卫（WXG-T-047）：最严重的一类问题放最前——密钥一旦进入提交历史，
#     改写历史远比拦下来昂贵。零依赖纯 Node；扫描面 =「会入仓的文件集」；
#     红线无「自动修复」语义，故**拦截而不重建**（同 ①¾ check:mcp 的取向）。
echo "[pre-commit] pnpm run check:secrets"
if command -v pnpm >/dev/null 2>&1; then
  pnpm run check:secrets
else
  node tools/scripts/check-secrets.mjs
fi

echo "[pre-commit] pnpm run check:links"
if command -v pnpm >/dev/null 2>&1; then
  pnpm run check:links
else
  node tools/scripts/check-ide-links.mjs
fi

# ①½ my-plugins vendor 锚与 MCP 配置锚一致性（WXG-T-035）：防快照与运行版本漂移。
echo "[pre-commit] pnpm run check:plugins"
if command -v pnpm >/dev/null 2>&1; then
  pnpm run check:plugins
else
  node tools/scripts/check-plugin-anchor.mjs
fi

# ①¾ MCP 配置漂移（WXG-T-043）：三份 IDE 配置须 == `my-mcp/servers.json` 渲染结果。
#     与 ② 的 ctx 相反，此处**拦截而不自动重建**：MCP 配置错误的后果是 IDE 侧静默失效
#     （本次 T-043 的起因就是三处手写漂移），静默重写比让人改正本更危险。
echo "[pre-commit] pnpm run check:mcp"
if command -v pnpm >/dev/null 2>&1; then
  pnpm run check:mcp
else
  node tools/scripts/build-mcp-configs.mjs --check
fi

# ② ctx 索引自动重建（WXG-T-032 ⑤）：先探测暂存区是否含 .md（≈0 开销）；有才执行。
STAGED_MD="$(git diff --cached --name-only | grep '\.md$' || true)"
if [ -n "$STAGED_MD" ]; then
  echo "[pre-commit] node tools/scripts/build-context-index.mjs --staged-blobs（自动重建索引）"
  if ! node tools/scripts/build-context-index.mjs --staged-blobs; then
    echo ""
    echo "❌ 提交被阻止：ctx 索引自动重建失败（见上方错误）。"
    echo "   修复：手动执行 pnpm run ctx:build 后重试；仍失败请上报主理人（勿用 --no-verify）。"
    exit 1
  fi
  git add ctx/index.json ctx/BUDGET.md ctx/hot-files.md memory/INDEX.md
  echo "[pre-commit] 已自动重建索引并重新暂存（--staged-blobs）"
  echo "[pre-commit] node tools/scripts/check-context-budget.mjs --staged（兜底终校验）"
  if ! node tools/scripts/check-context-budget.mjs --staged; then
    echo ""
    echo "❌ 提交被阻止：暂存内容与刚重建的索引仍不一致（异常情况，见上方诊断）。"
    echo "   多为重建后暂存内容又被并发改动；确认无冲突后重新提交即可再次自动重建。"
    exit 1
  fi
fi
